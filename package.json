{
  "name": "dsh-inline-branches",
  "version": "1.0.2",
  "type": "module",
  "description": "DeepSeek Harness plugin: nested turn folders and Finder-style show/hide for chat turns, without creating a new Session.",
  "license": "MIT",
  "author": "Yueyuan Huang",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "conversation-tree",
    "chat-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NekoYellow/dsh-inline-branches.git"
  },
  "homepage": "https://github.com/NekoYellow/dsh-inline-branches#readme",
  "bugs": {
    "url": "https://github.com/NekoYellow/dsh-inline-branches/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "figures/new-sub-conversation.png",
    "figures/tree-bar.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
